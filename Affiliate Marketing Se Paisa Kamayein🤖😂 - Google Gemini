*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:var(--font);font-size:15px;line-height:1.6;color:var(--txt);background:var(--bg-page);min-height:100vh;transition:background .3s ease,color .3s ease}

        <span class="hljs-attr">elapsed</span>: <span class="hljs-number">0</span>,
        <span class="hljs-attr">isPlaying</span>: <span class="hljs-literal">false</span>,
        <span class="hljs-attr">timerId</span>: <span class="hljs-literal">null</span>

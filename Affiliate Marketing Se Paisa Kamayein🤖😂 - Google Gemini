            state.timerId = setInterval(() =&gt; {
              state.elapsed++;
              updateTimerDisplay();

              if (state.elapsed &gt;= state.duration) {
                stopPlayback('‚úÖ Speaker cleaning cycle complete!', 'success');
                BackendService.logCleaningHistory(state.currentFreq, state.duration);

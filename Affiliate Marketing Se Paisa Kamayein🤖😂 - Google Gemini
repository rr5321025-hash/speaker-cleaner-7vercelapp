        DOM.fbYes = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'fb-yes'</span>);
        DOM.fbNo = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'fb-no'</span>);
        DOM.fbComment = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'fb-comment'</span>);

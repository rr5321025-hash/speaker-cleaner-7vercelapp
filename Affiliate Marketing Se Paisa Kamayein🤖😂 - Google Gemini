          tab.addEventListener('click', () =&gt; selectMode(tab.getAttribute('data-mode')));
        });

        DOM.presetBtns.forEach(btn =&gt; {
          btn.addEventListener('click', () =&gt; selectFrequency(parseInt(btn.getAttribute('data-freq'), 10)));
        });

        // FAQ Accordion
        document.querySelectorAll('.faq-item').forEach(item =&gt; {
          const btn = item.querySelector('.faq-btn');
          if (btn) {
            btn.addEventListener('click', () =&gt; {
              const isOpen = item.classList.contains('active');
              document.querySelectorAll('.faq-item').forEach(el =&gt; el.classList.remove('active'));
              if (!isOpen) {
                item.classList.add('active');
                BackendService.logAnalyticsEvent('faq_expanded', {
                  faq_id: item.getAttribute('data-faq-id')
                });
              }
            });
          }
        });

        // Newsletter Form
        if (DOM.newsletterForm) {
          DOM.newsletterForm.addEventListener('submit', async (e) =&gt; {
            e.preventDefault();
            const email = DOM.newsletterEmail.value;
            DOM.newsletterStatus.textContent = 'Subscribing...';
            DOM.newsletterStatus.style.color = 'var(--c-p200)';

            try {
              const res = await BackendService.subscribeNewsletter(email);
              DOM.newsletterStatus.textContent = '‚úÖ ' + res.message;
              DOM.newsletterStatus.style.color = '#86efac';
              DOM.newsletterForm.reset();
            } catch (err) {
              DOM.newsletterStatus.textContent = '‚ùå Subscription failed. Please try again.';
              DOM.newsletterStatus.style.color = '#fca5a5';
            }
          });
        }

        // Contact Form
        if (DOM.contactForm) {
          DOM.contactForm.addEventListener('submit', async (e) =&gt; {
            e.preventDefault();
            DOM.contactBtn.disabled = true;
            DOM.contactStatus.textContent = 'Sending message...';
            DOM.contactStatus.style.color = 'var(--c-p600)';

            const formData = {
              name: document.getElementById('c-name').value,
              email: document.getElementById('c-email').value,
              subject: document.getElementById('c-subject').value,
              message: document.getElementById('c-msg').value
            };

            try {
              await BackendService.submitContactForm(formData);
              DOM.contactStatus.textContent = '‚úÖ Thank you! Your message has been sent.';
              DOM.contactStatus.style.color = 'var(--c-s600)';
              DOM.contactForm.reset();
            } catch (err) {
              DOM.contactStatus.textContent = '‚ùå Failed to send message. Please try again.';
              DOM.contactStatus.style.color = '#dc2626';
            } finally {
              DOM.contactBtn.disabled = false;
            }
          });
        }

        // Feedback Handlers
        if (DOM.fbYes &amp;&amp; DOM.fbNo) {
          DOM.fbYes.addEventListener('click', () =&gt; {
            state.feedbackHelpful = true;
            DOM.fbYes.classList.add('selected');
            DOM.fbNo.classList.remove('selected');
            DOM.fbComment.style.display = 'block';
            DOM.fbSubmit.style.display = 'block';

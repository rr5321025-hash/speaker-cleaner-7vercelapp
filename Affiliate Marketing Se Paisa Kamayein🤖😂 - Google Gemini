      }

      <span class="hljs-keyword">async</span> <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">ensureActiveContext</span>(<span class="hljs-params"></span>) </span>{
        <span class="hljs-keyword">const</span> ctx = getContext();
        <span class="hljs-keyword">if</span> (ctx.state === <span class="hljs-string">'suspended'</span>) {
          <span class="hljs-keyword">await</span> ctx.resume();
        }
      }

      <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">startTone</span>(<span class="hljs-params">frequency</span>) </span>{
        <span class="hljs-keyword">try</span> {
          <span class="hljs-keyword">const</span> ctx = getContext();

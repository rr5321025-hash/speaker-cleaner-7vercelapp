.hero{background:linear-gradient(145deg, #0284c7 0%, #0369a1 50%, #0f172a 100%);color:#fff;padding:40px 20px 48px;text-align:center;border-radius:0 0 28px 28px;box-shadow:var(--sh-lg)}
.hero-inner{max-width:540px;margin:0 auto}
.hero-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.15);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.3);border-radius:var(--r-full);padding:6px 16px;font-size:12px;font-weight:700;margin-bottom:16px}
.hero h1{font-size:clamp(24px, 6vw, 34px);font-weight:800;line-height:1.2;margin-bottom:12px}
.hero p{font-size:14px;opacity:.9;line-height:1.6;margin-bottom:20px}
.quick-eject-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:#22c55e;color:#fff;font-size:15px;font-weight:800;padding:14px 28px;border-radius:var(--r-full);border:none;box-shadow:0 4px 20px rgba(34,197,94,.4);transition:all .2s ease}
.quick-eject-btn:hover{transform:translateY(-2px);box-shadow:0 6px 24px rgba(34,197,94,.5)}

/* Tool UI */
.tool-card{background:var(--bg-sur);border:1px solid var(--bdr);border-radius:var(--r-xl);padding:24px;box-shadow:var(--sh-lg);margin-top:-24px;position:relative;z-index:10;max-width:540px;margin-left:auto;margin-right:auto}
.mode-tabs{display:flex;gap:8px;margin-bottom:20px}
.mode-tab{flex:1;padding:12px 8px;border-radius:var(--r-md);border:1.5px solid var(--bdr);background:var(--bg-sur2);font-size:12px;font-weight:700;color:var(--txt2);text-align:center;transition:all .2s ease;min-height:48px}
.mode-tab.active{border-color:var(--c-p500);background:var(--c-p50);color:var(--c-p700)}
[data-theme="dark"] .mode-tab.active{background:rgba(14,165,233,.15);color:var(--c-p400)}

/* Presets */
.preset-section{margin-bottom:20px}
.preset-title{font-size:12px;font-weight:700;color:var(--txt3);text-transform:uppercase;margin-bottom:8px;display:block}
.preset-grid{display:grid;grid-template-columns:repeat(3, 1fr);gap:8px}
.preset-btn{padding:10px;border-radius:var(--r-md);border:1px solid var(--bdr);background:var(--bg-sur2);color:var(--txt);font-size:12px;font-weight:700;transition:all .2s ease;min-height:44px}
.preset-btn:hover, .preset-btn.active{border-color:var(--c-p500);background:var(--c-p500);color:#fff}

/* Visualizer */
.visualizer-box{background:linear-gradient(180deg, var(--bg-sur2), var(--bg-sur));border:1.5px solid var(--bdr);border-radius:var(--r-lg);padding:20px;height:90px;display:flex;align-items:center;justify-content:center;gap:4px;margin-bottom:20px;overflow:hidden}
.v-bar{width:6px;border-radius:3px;height:8px;background:var(--c-p200);transition:height .1s ease, background-color .2s ease}
.v-bar.active{background:linear-gradient(180deg, var(--c-p400), var(--c-p600));animation:pulseWave 0.6s infinite alternate ease-in-out}

@keyframes pulseWave { 0% { height: 12px; } 100% { height: 60px; } }

/* Controls */
.controls{display:flex;align-items:center;gap:16px;margin-bottom:20px}
.main-play-btn{width:64px;height:64px;border-radius:var(--r-full);background:linear-gradient(135deg,var(--c-p500),var(--c-p700));border:none;color:#fff;font-size:24px;display:flex;align-items:center;justify-content:center;box-shadow:var(--sh-p);transition:all .2s ease;flex-shrink:0}
.main-play-btn.playing{background:linear-gradient(135deg,#ef4444,#dc2626)}
.prog-container{flex:1}
.prog-bar-bg{height:8px;background:var(--bg-sur2);border-radius:var(--r-full);overflow:hidden;margin-bottom:6px;border:1px solid var(--bdr)}
.prog-bar-fill{height:100%;width:0%;background:linear-gradient(90deg,var(--c-p500),var(--c-s500));transition:width .3s linear}
.time-info{display:flex;justify-content:space-between;font-size:11px;color:var(--txt3);font-family:monospace}

.status-msg{padding:12px;border-radius:var(--r-md);font-size:13px;font-weight:600;text-align:center;margin-bottom:16px;display:none}
.status-msg.success{background:var(--c-s50);color:var(--c-s600);border:1px solid #86efac;display:block}
.status-msg.info{background:var(--c-p50);color:var(--c-p700);border:1px solid var(--c-p200);display:block}
.status-msg.error{background:#fef2f2;color:#dc2626;border:1px solid #fca5a5;display:block}

/* Section Common */
.sec-header{text-align:center;margin-bottom:32px}
.sec-title{font-size:24px;font-weight:800;color:var(--txt);margin-bottom:8px}
.sec-subtitle{font-size:14px;color:var(--txt2);max-width:580px;margin:0 auto}

/* Modals &amp; Overlay (Phase 11) */
.modal-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(15,23,42,0.6);backdrop-filter:blur(4px);z-index:2000;display:none;align-items:center;justify-content:center;padding:16px}
.modal-overlay.active{display:flex}
.modal-card{background:var(--bg-sur);border:1px solid var(--bdr);border-radius:var(--r-xl);max-width:440px;width:100%;padding:28px;box-shadow:var(--sh-lg);position:relative;animation:modalPop 0.25s ease-out}
@keyframes modalPop { from{opacity:0;transform:scale(0.95)} to{opacity:1;transform:scale(1)} }
.modal-close{position:absolute;top:16px;right:16px;background:none;border:none;font-size:20px;color:var(--txt3);cursor:pointer}

/* Auth Tabs &amp; Forms */
.auth-tabs{display:flex;gap:8px;margin-bottom:20px;border-bottom:1px solid var(--bdr);padding-bottom:10px}
.auth-tab-btn{flex:1;background:none;border:none;padding:8px;font-size:14px;font-weight:700;color:var(--txt3);border-bottom:2px solid transparent}
.auth-tab-btn.active{color:var(--c-p600);border-color:var(--c-p600)}
.social-auth-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px}
.social-btn{display:flex;align-items:center;justify-content:center;gap:8px;padding:10px;border-radius:var(--r-md);border:1px solid var(--bdr);background:var(--bg-sur2);color:var(--txt);font-weight:700;font-size:13px;transition:background .2s ease}
.social-btn:hover{background:var(--bdr)}
.auth-divider{text-align:center;position:relative;margin:16px 0;font-size:12px;color:var(--txt3)}
.auth-divider::before{content:"";position:absolute;top:50%;left:0;right:0;height:1px;background:var(--bdr);z-index:1}
.auth-divider span{position:relative;z-index:2;background:var(--bg-sur);padding:0 8px}

/* User Dashboard Section (Phase 11) */
.dash-section{padding:40px 0;display:none}
.dash-section.active{display:block}
.dash-grid{display:grid;grid-template-columns:260px 1fr;gap:24px}
@media (max-width:768px){.dash-grid{grid-template-columns:1fr}}
.dash-card{background:var(--bg-sur);border:1px solid var(--bdr);border-radius:var(--r-xl);padding:24px;box-shadow:var(--sh-md)}
.user-profile-header{text-align:center;margin-bottom:20px}
.user-avatar-lg{width:72px;height:72px;border-radius:50%;background:var(--c-p500);color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:28px;font-weight:800;margin-bottom:10px}
.history-table{width:100%;border-collapse:collapse;margin-top:12px;font-size:13px}
.history-table th, .history-table td{padding:10px;text-align:left;border-bottom:1px solid var(--bdr)}
.history-table th{color:var(--txt3);font-size:11px;text-transform:uppercase}
.role-badge{display:inline-block;padding:2px 8px;border-radius:var(--r-full);font-size:10px;font-weight:800;background:var(--c-p100);color:var(--c-p700);text-transform:uppercase}

/* Contact &amp; Feedback &amp; Newsletter UI */
.how-section, .benefits-section, .safety-section, .faq-section, .tools-section, .blog-section, .newsletter-section, .feedback-section, .contact-section {padding:50px 0 20px}
.steps-timeline{display:flex;flex-direction:column;gap:16px;max-width:680px;margin:0 auto}
.step-card{background:var(--bg-sur);border:1px solid var(--bdr);border-radius:var(--r-lg);padding:18px 20px;display:flex;align-items:flex-start;gap:16px}
.step-num{width:36px;height:36px;border-radius:var(--r-full);background:var(--c-p600);color:#fff;font-weight:800;font-size:15px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.step-content h3{font-size:15px;font-weight:700;color:var(--txt);margin-bottom:4px}
.step-content p{font-size:13px;color:var(--txt2);line-height:1.5}

.benefits-grid, .safety-grid, .tools-grid {display:grid;grid-template-columns:repeat(auto-fit, minmax(240px, 1fr));gap:16px}
.benefit-card, .safety-card, .tool-link-card {background:var(--bg-sur);border:1px solid var(--bdr);border-radius:var(--r-lg);padding:20px;display:flex;flex-direction:column;gap:10px;text-decoration:none}
.b-icon{width:42px;height:42px;border-radius:var(--r-md);background:var(--c-p50);color:var(--c-p600);display:flex;align-items:center;justify-content:center;font-size:20px}
.b-title{font-size:16px;font-weight:700;color:var(--txt)}
.b-desc{font-size:13px;color:var(--txt2);line-height:1.5}

.safety-card{background:var(--c-w50);border-color:var(--c-w200);flex-direction:row;align-items:flex-start}
.s-icon{font-size:24px}
.s-content h3{font-size:15px;font-weight:700;color:var(--c-w800)}
.s-content p{font-size:13px;color:var(--txt2)}

.faq-container{max-width:720px;margin:0 auto;display:flex;flex-direction:column;gap:12px}
.faq-item{background:var(--bg-sur);border:1px solid var(--bdr);border-radius:var(--r-lg);overflow:hidden}
.faq-btn{width:100%;padding:18px 20px;background:none;border:none;text-align:left;display:flex;align-items:center;justify-content:space-between;font-size:15px;font-weight:700;color:var(--txt)}
.faq-icon{width:24px;height:24px;border-radius:var(--r-full);background:var(--bg-sur2);display:flex;align-items:center;justify-content:center;font-size:12px;transition:transform .3s ease}
.faq-item.active .faq-icon{transform:rotate(180deg);background:var(--c-p500);color:#fff}
.faq-body{max-height:0;overflow:hidden;transition:max-height .3s ease;padding:0 20px}
.faq-item.active .faq-body{max-height:300px;padding:0 20px 18px}

.tool-link-card{position:relative}
.tool-badge{position:absolute;top:14px;right:14px;background:var(--bg-sur2);color:var(--txt3);font-size:10px;font-weight:700;padding:3px 8px;border-radius:var(--r-full);border:1px solid var(--bdr)}

/* Blog Preview Grid */
.blog-grid{display:grid;grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));gap:20px}
.blog-card{background:var(--bg-sur);border:1px solid var(--bdr);border-radius:var(--r-lg);overflow:hidden;display:flex;flex-direction:column;transition:all .25s ease;text-decoration:none;color:inherit}
.blog-card:hover{transform:translateY(-4px);box-shadow:var(--sh-md);border-color:var(--c-p400)}
.blog-thumb{width:100%;height:150px;background:linear-gradient(135deg, var(--c-p500), var(--c-p700));display:flex;align-items:center;justify-content:center;font-size:40px;color:#fff;position:relative}
.blog-cat{position:absolute;bottom:10px;left:10px;background:rgba(15,23,42,0.75);backdrop-filter:blur(4px);color:#fff;font-size:11px;font-weight:700;padding:3px 10px;border-radius:var(--r-full)}
.blog-content{padding:16px;display:flex;flex-direction:column;flex:1}
.blog-meta{font-size:11px;color:var(--txt3);margin-bottom:8px;display:flex;gap:12px;align-items:center}
.blog-title{font-size:15px;font-weight:700;color:var(--txt);line-height:1.4;margin-bottom:8px}
.blog-excerpt{font-size:13px;color:var(--txt2);line-height:1.5;margin-bottom:14px;flex:1}
.blog-read-btn{font-size:12px;font-weight:700;color:var(--c-c600);display:inline-flex;align-items:center;gap:4px;text-decoration:none}

/* Newsletter Section */
.newsletter-box{background:linear-gradient(135deg, var(--c-p600), var(--c-p700));color:#fff;border-radius:var(--r-xl);padding:32px 24px;text-align:center;max-width:720px;margin:0 auto;box-shadow:var(--sh-lg)}
.newsletter-box h3{font-size:22px;font-weight:800;margin-bottom:8px}
.newsletter-box p{font-size:13.5px;opacity:.9;margin-bottom:20px;max-width:500px;margin-left:auto;margin-right:auto}
.nl-form{display:flex;gap:10px;max-width:440px;margin:0 auto;flex-wrap:wrap}
.nl-input{flex:1;min-width:220px;padding:12px 16px;border-radius:var(--r-full);border:none;font-size:14px;outline:none}
.nl-btn{padding:12px 24px;border-radius:var(--r-full);border:none;background:#22c55e;color:#fff;font-weight:800;font-size:14px;transition:all .2s ease}
.nl-btn:hover{background:#16a34a;transform:translateY(-1px)}
.nl-privacy{font-size:11px;opacity:.75;margin-top:10px;display:block}

/* Feedback Section */
.feedback-box{background:var(--bg-sur);border:1px solid var(--bdr);border-radius:var(--r-xl);padding:24px;max-width:580px;margin:0 auto;text-align:center;box-shadow:var(--sh-md)}
.fb-buttons{display:flex;justify-content:center;gap:16px;margin:16px 0}
.fb-btn{padding:10px 20px;border-radius:var(--r-full);border:1px solid var(--bdr);background:var(--bg-sur2);color:var(--txt);font-weight:700;font-size:14px;display:inline-flex;align-items:center;gap:8px;transition:all .2s ease}
.fb-btn:hover, .fb-btn.selected{border-color:var(--c-p500);background:var(--c-p500);color:#fff}
.fb-textarea{width:100%;min-height:80px;padding:12px;border-radius:var(--r-md);border:1px solid var(--bdr);background:var(--bg-sur2);color:var(--txt);margin-top:12px;resize:vertical;font-size:13px;display:none}

/* Contact Section */
.contact-form{max-width:580px;margin:0 auto;background:var(--bg-sur);border:1px solid var(--bdr);border-radius:var(--r-xl);padding:28px;box-shadow:var(--sh-md)}
.form-group{margin-bottom:16px;text-align:left}
.form-label{display:block;font-size:12px;font-weight:700;color:var(--txt2);margin-bottom:6px;text-transform:uppercase;letter-spacing:.5px}
.form-input, .form-textarea, .form-select{width:100%;padding:12px 14px;border-radius:var(--r-md);border:1px solid var(--bdr);background:var(--bg-sur2);color:var(--txt);font-size:14px;outline:none;transition:border-color .2s ease}
.form-input:focus, .form-textarea:focus, .form-select:focus{border-color:var(--c-p500)}
.form-textarea{min-height:110px;resize:vertical}
.submit-btn{width:100%;padding:14px;border-radius:var(--r-md);border:none;background:var(--c-p600);color:#fff;font-weight:800;font-size:15px;transition:background .2s ease}
.submit-btn:hover{background:var(--c-p700)}

/* Premium Footer */
.site-footer{background:var(--bg-sur);border-top:1px solid var(--bdr);margin-top:60px;padding:50px 0 24px;font-size:13px;color:var(--txt2)}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:32px;margin-bottom:40px}
@media (max-width: 768px) {
  .footer-grid{grid-template-columns:1fr 1fr;gap:24px}
  .footer-brand-col{grid-column: span 2}
}
@media (max-width: 480px) {
  .footer-grid{grid-template-columns:1fr;gap:20px}
  .footer-brand-col{grid-column: span 1}
}
.f-brand-logo{display:flex;align-items:center;gap:8px;font-size:18px;font-weight:800;color:var(--c-p600);margin-bottom:12px}
.f-desc{font-size:13px;color:var(--txt3);line-height:1.6;margin-bottom:16px;max-width:300px}
.f-trust{display:inline-flex;align-items:center;gap:6px;background:var(--bg-sur2);padding:6px 12px;border-radius:var(--r-md);font-size:11px;font-weight:700;color:var(--c-s600);border:1px solid var(--bdr)}
.f-title{font-size:14px;font-weight:700;color:var(--txt);margin-bottom:14px;text-transform:uppercase;letter-spacing:.5px}
.f-links{list-style:none;display:flex;flex-direction:column;gap:10px}
.f-links a{color:var(--txt2);text-decoration:none;transition:color .2s ease;font-weight:500}
.f-links a:hover{color:var(--c-p500)}

.footer-bottom{border-top:1px solid var(--bdr);padding-top:20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:12px;color:var(--txt3)}

button{cursor:pointer}
:focus-visible{outline:2px solid var(--c-p500);outline-offset:2px;border-radius:var(--r-sm)}
.container{width:100%;max-width:860px;margin:0 auto;padding:0 16px}

/* Header */
.site-header{position:sticky;top:0;z-index:900;background:var(--bg-sur);border-bottom:1px solid var(--bdr);box-shadow:var(--sh-sm)}
.header-inner{display:flex;align-items:center;justify-content:space-between;height:58px;max-width:900px;margin:0 auto;padding:0 16px}
.site-logo{display:flex;align-items:center;gap:8px;font-size:16px;font-weight:800;color:var(--c-p600);text-decoration:none}
.logo-mark{width:32px;height:32px;background:linear-gradient(135deg,var(--c-p500),var(--c-p700));border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:16px}

/* Nav links */
.site-nav{display:flex;gap:12px;align-items:center}
.nav-link{color:var(--txt2);text-decoration:none;font-size:13px;font-weight:600;transition:color .2s ease}
.nav-link:hover{color:var(--c-p500)}
.auth-nav-btn{background:var(--c-p600);color:#fff;padding:6px 14px;border-radius:var(--r-full);font-size:12px;font-weight:700;border:none;transition:background .2s ease}
.auth-nav-btn:hover{background:var(--c-p700)}
.user-avatar-nav{width:32px;height:32px;border-radius:50%;background:var(--c-p500);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;cursor:pointer}


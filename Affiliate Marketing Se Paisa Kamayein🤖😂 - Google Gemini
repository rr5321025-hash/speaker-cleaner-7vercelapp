          gainNode = ctx.createGain();
          gainNode.gain.setValueAtTime(<span class="hljs-number">0.001</span>, ctx.currentTime);
          gainNode.gain.exponentialRampToValueAtTime(<span class="hljs-number">0.85</span>, ctx.currentTime + <span class="hljs-number">0.05</span>);
          gainNode.connect(ctx.destination);

          oscNode = ctx.createOscillator();
          oscNode.type = <span class="hljs-string">'sine'</span>;
          oscNode.frequency.setValueAtTime(frequency, ctx.currentTime);
          oscNode.connect(gainNode);
          oscNode.start();

          isRunning = <span class="hljs-literal">true</span>;
          <span class="hljs-keyword">return</span> <span class="hljs-literal">true</span>;
        } <span class="hljs-keyword">catch</span> (err) {
          <span class="hljs-built_in">console</span>.error(<span class="hljs-string">'Audio Engine Error:'</span>, err);
          <span class="hljs-keyword">return</span> <span class="hljs-literal">false</span>;
        }
      }

      <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">updateFrequency</span>(<span class="hljs-params">frequency</span>) </span>{
        <span class="hljs-keyword">if</span> (oscNode &amp;&amp; audioCtx) {
          oscNode.frequency.setValueAtTime(frequency, audioCtx.currentTime);
        }
      }

      <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">stopToneSilently</span>(<span class="hljs-params"></span>) </span>{
        <span class="hljs-keyword">if</span> (gainNode &amp;&amp; audioCtx) {
          <span class="hljs-keyword">try</span> {
            gainNode.gain.setValueAtTime(gainNode.gain.value, audioCtx.currentTime);
            gainNode.gain.exponentialRampToValueAtTime(<span class="hljs-number">0.001</span>, audioCtx.currentTime + <span class="hljs-number">0.03</span>);
          } <span class="hljs-keyword">catch</span>(e) {}
        }

        <span class="hljs-built_in">setTimeout</span>(<span class="hljs-function">() =&gt;</span> {
          <span class="hljs-keyword">if</span> (oscNode) {
            <span class="hljs-keyword">try</span> { oscNode.stop(); oscNode.disconnect(); } <span class="hljs-keyword">catch</span> (e) {}
            oscNode = <span class="hljs-literal">null</span>;
          }
          <span class="hljs-keyword">if</span> (gainNode) {
            <span class="hljs-keyword">try</span> { gainNode.disconnect(); } <span class="hljs-keyword">catch</span> (e) {}
            gainNode = <span class="hljs-literal">null</span>;
          }
        }, <span class="hljs-number">35</span>);

        isRunning = <span class="hljs-literal">false</span>;
      }

      <span class="hljs-keyword">return</span> {
        ensureActiveContext,
        startTone,
        updateFrequency,
        <span class="hljs-attr">stopTone</span>: stopToneSilently,
        <span class="hljs-attr">isPlaying</span>: <span class="hljs-function">() =&gt;</span> isRunning
      };
    })();

    <span class="hljs-comment">/* 2. APP CONTROLLER */</span>
    <span class="hljs-keyword">const</span> AppController = (<span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">const</span> state = {

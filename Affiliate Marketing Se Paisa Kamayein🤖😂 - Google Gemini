    /* ==========================================================================
       2. WEB AUDIO ENGINE MODULE
       ========================================================================== */
    const AudioEngine = (function() {
      let audioCtx = null;
      let oscNode = null;
      let gainNode = null;
      let isRunning = false;

      function getContext() {
        if (!audioCtx) {
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          if (!AudioContextClass) {
            throw new Error('Web Audio API is not supported on this browser.');
          }
          audioCtx = new AudioContextClass();
        }
        return audioCtx;
      }

      async function ensureActiveContext() {
        const ctx = getContext();
        if (ctx.state === 'suspended') {
          await ctx.resume();
        }
      }

      function startTone(frequency) {
        try {
          const ctx = getContext();
          stopToneSilently();

          gainNode = ctx.createGain();
          gainNode.gain.setValueAtTime(0.001, ctx.currentTime);
          gainNode.gain.exponentialRampToValueAtTime(0.85, ctx.currentTime + 0.05);
          gainNode.connect(ctx.destination);

          oscNode = ctx.createOscillator();
          oscNode.type = 'sine';
          oscNode.frequency.setValueAtTime(frequency, ctx.currentTime);
          oscNode.connect(gainNode);
          oscNode.start();

          isRunning = true;
          return true;
        } catch (err) {
          console.error('Audio Engine Error:', err);
          return false;
        }
      }

      function updateFrequency(frequency) {
        if (oscNode &amp;&amp; audioCtx) {
          oscNode.frequency.setValueAtTime(frequency, audioCtx.currentTime);
        }
      }

      function stopToneSilently() {
        if (gainNode &amp;&amp; audioCtx) {
          try {
            gainNode.gain.setValueAtTime(gainNode.gain.value, audioCtx.currentTime);
            gainNode.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.03);
          } catch(e) {}
        }

        setTimeout(() =&gt; {
          if (oscNode) {
            try { oscNode.stop(); oscNode.disconnect(); } catch (e) {}
            oscNode = null;
          }
          if (gainNode) {
            try { gainNode.disconnect(); } catch (e) {}
            gainNode = null;
          }
        }, 35);

        isRunning = false;
      }

      return {
        ensureActiveContext,
        startTone,
        updateFrequency,
        stopTone: stopToneSilently,
        isPlaying: () =&gt; isRunning
      };
    })();


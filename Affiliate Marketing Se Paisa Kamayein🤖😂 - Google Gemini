  <span class="hljs-tag">&lt;<span class="hljs-name">script</span>&gt;</span><span class="javascript"><span class="hljs-meta">
    'use strict'</span>;

    <span class="hljs-keyword">let</span> audioCtx = <span class="hljs-literal">null</span>, osc = <span class="hljs-literal">null</span>, gainNode = <span class="hljs-literal">null</span>;
    <span class="hljs-keyword">let</span> isPlaying = <span class="hljs-literal">false</span>, timer = <span class="hljs-literal">null</span>, currentFreq = <span class="hljs-number">165</span>, duration = <span class="hljs-number">45</span>, elapsed = <span class="hljs-number">0</span>;

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">toggleTheme</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">const</span> isDark = <span class="hljs-built_in">document</span>.documentElement.getAttribute(<span class="hljs-string">'data-theme'</span>) === <span class="hljs-string">'dark'</span>;
      <span class="hljs-built_in">document</span>.documentElement.setAttribute(<span class="hljs-string">'data-theme'</span>, isDark ? <span class="hljs-string">'light'</span> : <span class="hljs-string">'dark'</span>);
      <span class="hljs-built_in">localStorage</span>.setItem(<span class="hljs-string">'fms-theme'</span>, isDark ? <span class="hljs-string">'light'</span> : <span class="hljs-string">'dark'</span>);
    }

    <span class="hljs-comment">/* FAQ Accordion Toggle */</span>
    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">toggleFaq</span>(<span class="hljs-params">btn</span>) </span>{
      <span class="hljs-keyword">const</span> item = btn.parentElement;
      <span class="hljs-keyword">const</span> isOpen = item.classList.contains(<span class="hljs-string">'active'</span>);
      
      <span class="hljs-built_in">document</span>.querySelectorAll(<span class="hljs-string">'.faq-item'</span>).forEach(<span class="hljs-function"><span class="hljs-params">el</span> =&gt;</span> {
        el.classList.remove(<span class="hljs-string">'active'</span>);
        el.querySelector(<span class="hljs-string">'.faq-btn'</span>).setAttribute(<span class="hljs-string">'aria-expanded'</span>, <span class="hljs-string">'false'</span>);
      });

      <span class="hljs-keyword">if</span> (!isOpen) {
        item.classList.add(<span class="hljs-string">'active'</span>);
        btn.setAttribute(<span class="hljs-string">'aria-expanded'</span>, <span class="hljs-string">'true'</span>);
      }
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">initAudio</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">if</span> (!audioCtx) {
        <span class="hljs-keyword">const</span> AudioClass = <span class="hljs-built_in">window</span>.AudioContext || <span class="hljs-built_in">window</span>.webkitAudioContext;
        audioCtx = <span class="hljs-keyword">new</span> AudioClass();
      }
      <span class="hljs-keyword">if</span> (audioCtx.state === <span class="hljs-string">'suspended'</span>) {
        audioCtx.resume();
      }
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">startSound</span>(<span class="hljs-params">freq</span>) </span>{
      initAudio();
      stopSound();

      gainNode = audioCtx.createGain();
      gainNode.gain.setValueAtTime(<span class="hljs-number">1.0</span>, audioCtx.currentTime);
      gainNode.connect(audioCtx.destination);

      osc = audioCtx.createOscillator();
      osc.type = <span class="hljs-string">'sine'</span>;
      osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
      osc.connect(gainNode);
      osc.start();
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">stopSound</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">if</span> (osc) { <span class="hljs-keyword">try</span> { osc.stop(); osc.disconnect(); } <span class="hljs-keyword">catch</span>(e){} osc = <span class="hljs-literal">null</span>; }
      <span class="hljs-keyword">if</span> (gainNode) { <span class="hljs-keyword">try</span> { gainNode.disconnect(); } <span class="hljs-keyword">catch</span>(e){} gainNode = <span class="hljs-literal">null</span>; }
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">toggleAudio</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">const</span> btn = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'main-play'</span>);
      <span class="hljs-keyword">const</span> status = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'status-msg'</span>);
      <span class="hljs-keyword">const</span> bars = <span class="hljs-built_in">document</span>.querySelectorAll(<span class="hljs-string">'.v-bar'</span>);

      <span class="hljs-keyword">if</span> (isPlaying) {
        isPlaying = <span class="hljs-literal">false</span>;
        <span class="hljs-built_in">clearInterval</span>(timer);
        stopSound();
        btn.textContent = <span class="hljs-string">'‚ñ∂'</span>;
        btn.classList.remove(<span class="hljs-string">'playing'</span>);
        status.className = <span class="hljs-string">'status-msg info'</span>;
        status.textContent = <span class="hljs-string">'Cleaning paused. Click play to resume.'</span>;
        bars.forEach(<span class="hljs-function"><span class="hljs-params">b</span> =&gt;</span> b.classList.remove(<span class="hljs-string">'active'</span>));
      } <span class="hljs-keyword">else</span> {
        isPlaying = <span class="hljs-literal">true</span>;
        startSound(currentFreq);
        btn.textContent = <span class="hljs-string">'‚è∏'</span>;
        btn.classList.add(<span class="hljs-string">'playing'</span>);
        status.className = <span class="hljs-string">'status-msg info'</span>;
        status.textContent = <span class="hljs-string">'üîä Sound frequency playing! Keep phone volume at 100%.'</span>;

        bars.forEach(<span class="hljs-function">(<span class="hljs-params">b, idx</span>) =&gt;</span> {
          b.classList.add(<span class="hljs-string">'active'</span>);
          b.style.animationDelay = <span class="hljs-string">`<span class="hljs-subst">${(idx % <span class="hljs-number">4</span>) * <span class="hljs-number">0.15</span>}</span>s`</span>;
        });

        timer = <span class="hljs-built_in">setInterval</span>(<span class="hljs-function">() =&gt;</span> {
          elapsed++;
          <span class="hljs-keyword">const</span> pct = (elapsed / duration) * <span class="hljs-number">100</span>;
          <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'prog-fill'</span>).style.width = pct + <span class="hljs-string">'%'</span>;
          <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'t-current'</span>).textContent = <span class="hljs-string">`0:<span class="hljs-subst">${elapsed &lt; <span class="hljs-number">10</span> ? <span class="hljs-string">'0'</span> : <span class="hljs-string">''</span>}</span><span class="hljs-subst">${elapsed}</span>`</span>;

          <span class="hljs-keyword">if</span> (elapsed &gt;= duration) {
            toggleAudio();
            elapsed = <span class="hljs-number">0</span>;
            status.className = <span class="hljs-string">'status-msg success'</span>;
            status.textContent = <span class="hljs-string">'‚úÖ Speaker cleaning cycle complete!'</span>;
          }
        }, <span class="hljs-number">1000</span>);
      }
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">selectPreset</span>(<span class="hljs-params">freq</span>) </span>{
      currentFreq = freq;
      <span class="hljs-built_in">document</span>.querySelectorAll(<span class="hljs-string">'.preset-btn'</span>).forEach(<span class="hljs-function"><span class="hljs-params">b</span> =&gt;</span> b.classList.remove(<span class="hljs-string">'active'</span>));
      <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'p-'</span> + freq).classList.add(<span class="hljs-string">'active'</span>);
      <span class="hljs-keyword">if</span> (isPlaying) { startSound(currentFreq); }
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">setMode</span>(<span class="hljs-params">mode</span>) </span>{
      <span class="hljs-built_in">document</span>.querySelectorAll(<span class="hljs-string">'.mode-tab'</span>).forEach(<span class="hljs-function"><span class="hljs-params">t</span> =&gt;</span> t.classList.remove(<span class="hljs-string">'active'</span>));
      <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'tab-'</span> + mode).classList.add(<span class="hljs-string">'active'</span>);
      <span class="hljs-keyword">if</span> (mode === <span class="hljs-string">'water'</span>) selectPreset(<span class="hljs-number">165</span>);
      <span class="hljs-keyword">if</span> (mode === <span class="hljs-string">'dust'</span>) selectPreset(<span class="hljs-number">240</span>);
      <span class="hljs-keyword">if</span> (mode === <span class="hljs-string">'deep'</span>) selectPreset(<span class="hljs-number">440</span>);
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">startQuickEject</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'main-tool'</span>).scrollIntoView({ <span class="hljs-attr">behavior</span>: <span class="hljs-string">'smooth'</span> });
      setMode(<span class="hljs-string">'water'</span>);
      <span class="hljs-keyword">if</span> (!isPlaying) toggleAudio();
    }
